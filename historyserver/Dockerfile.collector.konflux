# Collector sidecar image for Konflux / RHOAI (RHAI-23424).
# Build context: historyserver/ (repository root for this component).
ARG SOURCE_CODE=.
ARG RUNTIME_IMAGE=registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:5e9a0970f73f4800445c3ce0ca0d6b7ea1a8c620b81e735d16432db09d6787bc

FROM registry.access.redhat.com/ubi9/go-toolset@sha256:51eef2836e5223c41577757c30544fbfb3f0710f3436b70b82d2195e35fcb743 AS builder

ARG TARGETOS
ARG TARGETARCH
ARG COMMIT_SHA1=unknown
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /historyserver
USER root

COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/collector/main.go cmd/collector/main.go
COPY pkg/collector/ pkg/collector/
COPY pkg/storage/ pkg/storage/
COPY pkg/utils/ pkg/utils/
COPY pkg/eventserver/ pkg/eventserver/
COPY pkg/compression/ pkg/compression/

RUN mkdir -p output/bin && \
    CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} GOEXPERIMENT=strictfipsruntime \
    go build -tags strictfipsruntime \
      -ldflags="-X main.commitID=${COMMIT_SHA1}" \
      -a -o output/bin/collector ./cmd/collector/main.go

FROM ${RUNTIME_IMAGE}

RUN microdnf update -y && \
    microdnf install -y ca-certificates && \
    microdnf clean all

COPY --from=builder /historyserver/output/bin/collector /usr/local/bin/collector

# UID 1000 matches the Ray user / run-as-ray-user SCC.
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/collector"]
